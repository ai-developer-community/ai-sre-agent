PROJECT_ID=personal-infrastructure-505708
REGION=europe-west2
SHOP_SERVICE=sre-demo-shop
DATABASE_URL=postgresql+psycopg://sre_demo:local-demo-only@127.0.0.1:55432/sre_demo
AGENT_PROVIDER=vertex
# Set to the exact Claude model enabled for this project and location.
CLAUDE_MODEL=
VERTEX_REGION=global
# Application Default Credentials are separate from gcloud CLI login.
# Use impersonated ADC for sre-demo-investigator with read-only infrastructure roles.
SUBSCRIBER_ENABLED=false
PUBSUB_SUBSCRIPTION=sre-demo-agent
# For the explicit API alternative: AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY belongs only in this ignored .env file.
